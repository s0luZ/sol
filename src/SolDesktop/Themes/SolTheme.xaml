<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Defaults only. ThemeService replaces these at runtime from the user's settings,
         so everything that consumes them must use DynamicResource. -->
    <Color x:Key="Sol.AccentColor">#FFFFB547</Color>
    <SolidColorBrush x:Key="Sol.AccentBrush" Color="#FFFFB547" />
    <SolidColorBrush x:Key="Sol.OnAccentBrush" Color="#FF141416" />
    <SolidColorBrush x:Key="Sol.SurfaceBrush" Color="#F20D0D10" />
    <SolidColorBrush x:Key="Sol.SurfaceSolidBrush" Color="#FF0D0D10" />
    <SolidColorBrush x:Key="Sol.SurfaceRaisedBrush" Color="#FF1B1B1D" />
    <SolidColorBrush x:Key="Sol.SurfaceHoverBrush" Color="#FF29292A" />
    <SolidColorBrush x:Key="Sol.SurfaceBorderBrush" Color="#22F5F3EE" />
    <SolidColorBrush x:Key="Sol.ForegroundBrush" Color="#FFF5F3EE" />
    <SolidColorBrush x:Key="Sol.ForegroundDimBrush" Color="#99F5F3EE" />
    <SolidColorBrush x:Key="Sol.ForegroundFaintBrush" Color="#40F5F3EE" />
    <SolidColorBrush x:Key="Sol.SuccessBrush" Color="#FF5BD48A" />
    <SolidColorBrush x:Key="Sol.DangerBrush" Color="#FFFF6B5B" />

    <FontFamily x:Key="Sol.TextFont">Segoe UI Variable Text, Segoe UI</FontFamily>
    <!-- Segoe Fluent Icons ships with Windows 11, Segoe MDL2 Assets with Windows 10. -->
    <FontFamily x:Key="Sol.IconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

    <Style x:Key="Sol.IconText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Sol.IconFont}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Foreground" Value="{DynamicResource Sol.ForegroundBrush}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Margin" Value="6,0" />
    </Style>

</ResourceDictionary>

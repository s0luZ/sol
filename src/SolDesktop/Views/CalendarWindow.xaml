<Window x:Class="SolDesktop.Views.CalendarWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Sol Calendar"
        SizeToContent="WidthAndHeight"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True" ShowActivated="True"
        FontFamily="{DynamicResource Sol.TextFont}"
        Foreground="{DynamicResource Sol.ForegroundBrush}">

    <Border Width="292" Padding="16,14" CornerRadius="18" BorderThickness="1"
            Background="{DynamicResource Sol.SurfaceSolidBrush}"
            BorderBrush="{DynamicResource Sol.SurfaceBorderBrush}">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="6" Direction="270" Opacity="0.4" Color="Black" />
        </Border.Effect>
        <StackPanel>
            <Grid Margin="0,0,0,10">
                <Button HorizontalAlignment="Left" Style="{StaticResource Sol.IconButton}" Content="&#xE76B;" FontSize="12" Click="OnPrevious" />
                <TextBlock x:Name="MonthTitle" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="SemiBold" />
                <Button HorizontalAlignment="Right" Style="{StaticResource Sol.IconButton}" Content="&#xE76C;" FontSize="12" Click="OnNext" />
            </Grid>
            <UniformGrid x:Name="Weekdays" Columns="7" Margin="0,0,0,4" />
            <UniformGrid x:Name="Days" Columns="7" />
            <Button Style="{StaticResource Sol.Button}" HorizontalAlignment="Stretch" Margin="0,14,0,6"
                    Content="Notification settings" Click="OnNotifications" />
            <Button Style="{StaticResource Sol.Button}" HorizontalAlignment="Stretch"
                    Content="Do Not Disturb" Click="OnQuietHours" />
        </StackPanel>
    </Border>
</Window>

<Window x:Class="SolDesktop.Views.ControlCentreWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        xmlns:conv="clr-namespace:SolDesktop.Converters"
        xmlns:controls="clr-namespace:SolDesktop.Controls"
        xmlns:vm="clr-namespace:SolDesktop.ViewModels"
        Title="Sol Control Centre"
        SizeToContent="WidthAndHeight"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True" ShowActivated="False"
        UseLayoutRounding="True"
        FontFamily="{DynamicResource Sol.TextFont}"
        Foreground="{DynamicResource Sol.ForegroundBrush}">

    <Window.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVisibility" />
        <conv:NullToVisibilityConverter x:Key="NullToVisibility" />
        <conv:SignalBarOpacityConverter x:Key="SignalBarOpacity" />

        <Style x:Key="CC.Tile" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource Sol.SurfaceRaisedBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Sol.SurfaceBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="20" />
            <Setter Property="Padding" Value="12" />
        </Style>

        <Style x:Key="CC.Caption" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>

        <Style x:Key="CC.Detail" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="{DynamicResource Sol.ForegroundDimBrush}" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>

        <Style x:Key="CC.Glyph" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource Sol.IconFont}" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="HorizontalAlignment" Value="Center" />
        </Style>

        <!-- Round quick toggle; Tag=True lights it with the accent colour. -->
        <Style x:Key="CC.Round" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Width" Value="46" />
            <Setter Property="Height" Value="46" />
            <Setter Property="FontSize" Value="17" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Ellipse x:Name="Circle" Fill="{DynamicResource Sol.SurfaceHoverBrush}" />
                            <ContentPresenter x:Name="Glyph" HorizontalAlignment="Center" VerticalAlignment="Center"
                                              TextElement.FontFamily="{StaticResource Sol.IconFont}"
                                              TextElement.Foreground="{DynamicResource Sol.ForegroundBrush}" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Tag">
                                <Trigger.Value>
                                    <sys:Boolean>True</sys:Boolean>
                                </Trigger.Value>
                                <Setter TargetName="Circle" Property="Fill" Value="{DynamicResource Sol.AccentBrush}" />
                                <Setter TargetName="Glyph" Property="TextElement.Foreground" Value="{DynamicResource Sol.OnAccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Opacity" Value="0.88" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Opacity" Value="0.7" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.35" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Borderless clickable area (labels, list rows). -->
        <Style x:Key="CC.Row" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Foreground" Value="{DynamicResource Sol.ForegroundBrush}" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="10,7" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="12" Padding="{TemplateBinding Padding}" Background="Transparent">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Sol.SurfaceHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.75" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CC.Label" TargetType="Button" BasedOn="{StaticResource CC.Row}">
            <Setter Property="Padding" Value="4,3" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
        </Style>

        <Style x:Key="CC.Pill" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Foreground" Value="{DynamicResource Sol.ForegroundBrush}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="14" Padding="{TemplateBinding Padding}"
                                Background="{DynamicResource Sol.SurfaceHoverBrush}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.85" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.7" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CC.IconPill" TargetType="Button" BasedOn="{StaticResource CC.Pill}">
            <Setter Property="FontFamily" Value="{StaticResource Sol.IconFont}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="0" />
        </Style>

        <!-- Thick iOS-style level slider; the code-behind makes the whole bar draggable. -->
        <Style x:Key="CC.LevelRepeat" TargetType="RepeatButton">
            <Setter Property="OverridesDefaultStyle" Value="True" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="IsTabStop" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Border Background="{TemplateBinding Background}" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CC.Level" TargetType="Slider">
            <Setter Property="Minimum" Value="0" />
            <Setter Property="Maximum" Value="100" />
            <Setter Property="Height" Value="30" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid>
                            <Border x:Name="Mask" CornerRadius="15" Background="White" />
                            <Grid>
                                <Grid.OpacityMask>
                                    <VisualBrush Visual="{Binding ElementName=Mask}" />
                                </Grid.OpacityMask>
                                <Border Background="{DynamicResource Sol.SurfaceHoverBrush}" />
                                <Track x:Name="PART_Track">
                                    <Track.DecreaseRepeatButton>
                                        <RepeatButton Style="{StaticResource CC.LevelRepeat}" Background="{DynamicResource Sol.ForegroundBrush}" />
                                    </Track.DecreaseRepeatButton>
                                    <Track.IncreaseRepeatButton>
                                        <RepeatButton Style="{StaticResource CC.LevelRepeat}" Background="Transparent" />
                                    </Track.IncreaseRepeatButton>
                                    <Track.Thumb>
                                        <Thumb Width="0" Height="30" Opacity="0" />
                                    </Track.Thumb>
                                </Track>
                            </Grid>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CC.Password" TargetType="PasswordBox">
            <Setter Property="Foreground" Value="{DynamicResource Sol.ForegroundBrush}" />
            <Setter Property="CaretBrush" Value="{DynamicResource Sol.ForegroundBrush}" />
            <Setter Property="SelectionBrush" Value="{DynamicResource Sol.AccentBrush}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="PasswordBox">
                        <Border x:Name="Bd" Padding="10,6" CornerRadius="12" BorderThickness="1"
                                Background="{DynamicResource Sol.SurfaceHoverBrush}" BorderBrush="Transparent">
                            <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Sol.AccentBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="WifiArc" TargetType="Path">
            <Setter Property="Stroke" Value="{DynamicResource Sol.ForegroundBrush}" />
            <Setter Property="StrokeThickness" Value="2.4" />
            <Setter Property="StrokeStartLineCap" Value="Round" />
            <Setter Property="StrokeEndLineCap" Value="Round" />
        </Style>

        <!-- Content = signal bars (0-5) -->
        <DataTemplate x:Key="WifiBarsGlyph">
            <Viewbox Width="18" Height="18">
                <Canvas Width="24" Height="24">
                    <Path Style="{StaticResource WifiArc}" Data="M 9.17,15.17 A 4,4 0 0 1 14.83,15.17"
                          Opacity="{Binding Converter={StaticResource SignalBarOpacity}, ConverterParameter=1}" />
                    <Path Style="{StaticResource WifiArc}" Data="M 6.34,12.34 A 8,8 0 0 1 17.66,12.34"
                          Opacity="{Binding Converter={StaticResource SignalBarOpacity}, ConverterParameter=3}" />
                    <Path Style="{StaticResource WifiArc}" Data="M 3.51,9.51 A 12,12 0 0 1 20.49,9.51"
                          Opacity="{Binding Converter={StaticResource SignalBarOpacity}, ConverterParameter=4}" />
                    <Ellipse Canvas.Left="10.4" Canvas.Top="16.4" Width="3.2" Height="3.2" Fill="{DynamicResource Sol.ForegroundBrush}" />
                </Canvas>
            </Viewbox>
        </DataTemplate>
    </Window.Resources>

    <Grid Margin="28,0,28,28" ClipToBounds="True">
        <controls:FlaredPanel x:Name="Bar" Edge="Top"
                              HorizontalAlignment="Center" VerticalAlignment="Top"
                              Padding="16,12,16,16" CornerRadius="28"
                              Background="{DynamicResource Sol.SurfaceBrush}"
                              BorderBrush="{DynamicResource Sol.SurfaceBorderBrush}"
                              FlareRadius="{Binding FlareRadius, Source={x:Static vm:Appearance.Current}}">
            <controls:FlaredPanel.RenderTransform>
                <TranslateTransform x:Name="Slide" />
            </controls:FlaredPanel.RenderTransform>
            <controls:FlaredPanel.Effect>
                <DropShadowEffect BlurRadius="24" ShadowDepth="4" Direction="270" Opacity="0.5" Color="Black" />
            </controls:FlaredPanel.Effect>

            <Canvas x:Name="ClipHost" ClipToBounds="True" Width="356">
            <StackPanel x:Name="Sheet" Width="356" Canvas.Left="0" Canvas.Top="0">
                <StackPanel.LayoutTransform>
                    <ScaleTransform ScaleX="{Binding ControlCentreScale, Source={x:Static vm:Appearance.Current}}"
                                    ScaleY="{Binding ControlCentreScale, Source={x:Static vm:Appearance.Current}}" />
                </StackPanel.LayoutTransform>

                <!-- Header: clock + Sol settings -->
                <Grid Margin="4,2,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="{Binding TimeText}" FontSize="30" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding DateText}" FontSize="12.5" Foreground="{DynamicResource Sol.ForegroundDimBrush}" />
                    </StackPanel>
                    <Button Grid.Column="1" Style="{StaticResource CC.IconPill}" Content="&#xE713;"
                            VerticalAlignment="Top" ToolTip="Sol settings"
                            Command="{Binding OpenSolSettingsCommand}" />
                </Grid>

                <!-- ================= Main page ================= -->
                <StackPanel Visibility="{Binding IsMainPage, Converter={StaticResource BoolToVisibility}}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- Connectivity: tap the circle to toggle, tap the label for details -->
                        <Border Style="{StaticResource CC.Tile}" Padding="6,10">
                            <UniformGrid Rows="2" Columns="2">
                                <StackPanel Margin="0,0,0,4">
                                    <Button Style="{StaticResource CC.Round}" Content="&#xE701;"
                                            Tag="{Binding IsWifiOn}" IsEnabled="{Binding IsWifiAvailable}"
                                            Command="{Binding ToggleWifiCommand}" ToolTip="Turn Wi-Fi on or off" />
                                    <Button Style="{StaticResource CC.Label}" Command="{Binding ShowWifiCommand}" Margin="0,2,0,0">
                                        <StackPanel>
                                            <TextBlock Style="{StaticResource CC.Caption}" Text="Wi-Fi" HorizontalAlignment="Center" />
                                            <TextBlock Style="{StaticResource CC.Detail}" Text="{Binding WifiStatus}" HorizontalAlignment="Center" MaxWidth="68" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                                <StackPanel Margin="0,0,0,4">
                                    <Button Style="{StaticResource CC.Round}" Content="&#xE702;"
                                            Tag="{Binding IsBluetoothOn}" IsEnabled="{Binding IsBluetoothAvailable}"
                                            Command="{Binding ToggleBluetoothCommand}" ToolTip="Turn Bluetooth on or off" />
                                    <Button Style="{StaticResource CC.Label}" Command="{Binding ShowBluetoothCommand}" Margin="0,2,0,0">
                                        <StackPanel>
                                            <TextBlock Style="{StaticResource CC.Caption}" Text="Bluetooth" HorizontalAlignment="Center" />
                                            <TextBlock Style="{StaticResource CC.Detail}" Text="{Binding BluetoothStatus}" HorizontalAlignment="Center" MaxWidth="68" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                                <StackPanel>
                                    <Button Style="{StaticResource CC.Round}" Content="&#xE839;"
                                            Tag="{Binding IsEthernetConnected}"
                                            Command="{Binding ShowEthernetCommand}" ToolTip="Ethernet details" />
                                    <Button Style="{StaticResource CC.Label}" Command="{Binding ShowEthernetCommand}" Margin="0,2,0,0">
                                        <StackPanel>
                                            <TextBlock Style="{StaticResource CC.Caption}" Text="Ethernet" HorizontalAlignment="Center" />
                                            <TextBlock Style="{StaticResource CC.Detail}" Text="{Binding EthernetStatus}" HorizontalAlignment="Center" MaxWidth="68" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                                <StackPanel>
                                    <Button Style="{StaticResource CC.Round}" Content="&#xE7F5;"
                                            Tag="{Binding HasAudioDevice}"
                                            Command="{Binding ShowSoundCommand}" ToolTip="Choose sound output" />
                                    <Button Style="{StaticResource CC.Label}" Command="{Binding ShowSoundCommand}" Margin="0,2,0,0">
                                        <StackPanel>
                                            <TextBlock Style="{StaticResource CC.Caption}" Text="Output" HorizontalAlignment="Center" />
                                            <TextBlock Style="{StaticResource CC.Detail}" Text="{Binding OutputDeviceName}" HorizontalAlignment="Center" MaxWidth="68" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </UniformGrid>
                        </Border>

                        <!-- Now playing -->
                        <Border Grid.Column="2" Style="{StaticResource CC.Tile}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Border Width="56" Height="56" CornerRadius="12" HorizontalAlignment="Left"
                                        Background="{DynamicResource Sol.SurfaceHoverBrush}">
                                    <Grid>
                                        <TextBlock Style="{StaticResource CC.Glyph}" Text="&#xE8D6;" FontSize="22"
                                                   Foreground="{DynamicResource Sol.ForegroundDimBrush}"
                                                   Visibility="{Binding HasArtwork, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}" />
                                        <Border CornerRadius="12" Visibility="{Binding HasArtwork, Converter={StaticResource BoolToVisibility}}">
                                            <Border.Background>
                                                <ImageBrush ImageSource="{Binding MediaArtwork}" Stretch="UniformToFill" />
                                            </Border.Background>
                                        </Border>
                                    </Grid>
                                </Border>
                                <StackPanel Grid.Row="1" Margin="2,10,0,0" VerticalAlignment="Top">
                                    <TextBlock Style="{StaticResource CC.Caption}" Text="{Binding MediaTitle}" FontSize="12.5" />
                                    <TextBlock Style="{StaticResource CC.Detail}" Text="{Binding MediaArtist}" />
                                </StackPanel>
                                <Grid Grid.Row="2" Margin="0,8,0,0" IsEnabled="{Binding HasMedia}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition />
                                        <ColumnDefinition />
                                        <ColumnDefinition />
                                    </Grid.ColumnDefinitions>
                                    <Grid.Style>
                                        <Style TargetType="Grid">
                                            <Style.Triggers>
                                                <Trigger Property="IsEnabled" Value="False">
                                                    <Setter Property="Opacity" Value="0.35" />
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Grid.Style>
                                    <Button Style="{StaticResource CC.Row}" Padding="0,6" HorizontalContentAlignment="Center"
                                            Command="{Binding PreviousCommand}" ToolTip="Previous">
                                        <TextBlock Style="{StaticResource CC.Glyph}" Text="&#xE892;" />
                                    </Button>
                                    <Button Grid.Column="1" Style="{StaticResource CC.Row}" Padding="0,6" HorizontalContentAlignment="Center"
                                            Command="{Binding PlayPauseCommand}" ToolTip="Play / pause">
                                        <TextBlock Style="{StaticResource CC.Glyph}" Text="{Binding PlayPauseGlyph}" FontSize="18" />
                                    </Button>
                                    <Button Grid.Column="2" Style="{StaticResource CC.Row}" Padding="0,6" HorizontalContentAlignment="Center"
                                            Command="{Binding NextCommand}" ToolTip="Next">
                                        <TextBlock Style="{StaticResource CC.Glyph}" Text="&#xE893;" />
                                    </Button>
                                </Grid>
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- Volume -->
                    <Border Style="{StaticResource CC.Tile}" Margin="0,10,0,0" Padding="8,8,8,8"
                            Visibility="{Binding HasAudioDevice, Converter={StaticResource BoolToVisibility}}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Button Style="{StaticResource CC.IconPill}" Content="{Binding VolumeGlyph}" Background="Transparent"
                                    Command="{Binding ToggleMuteCommand}" ToolTip="Mute" />
                            <Slider Grid.Column="1" Style="{StaticResource CC.Level}" Margin="8,0"
                                    Value="{Binding Volume, Mode=TwoWay}" ToolTip="{Binding OutputDeviceName}"
                                    PreviewMouseLeftButtonDown="OnLevelMouseDown" PreviewMouseMove="OnLevelMouseMove"
                                    PreviewMouseLeftButtonUp="OnLevelMouseUp" MouseWheel="OnLevelWheel" />
                            <Button Grid.Column="2" Style="{StaticResource CC.IconPill}" Content="&#xE76C;"
                                    Command="{Binding ShowSoundCommand}" ToolTip="Choose output" />
                        </Grid>
                    </Border>

                    <!-- Brightness and Night Light -->
                    <Border Style="{StaticResource CC.Tile}" Margin="0,10,0,0" Padding="8,8,8,8"
                            Visibility="{Binding ShowDisplayControls, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel>
                            <Grid Visibility="{Binding HasBrightness, Converter={StaticResource BoolToVisibility}}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="32" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="32" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Style="{StaticResource CC.Glyph}" Text="&#xE706;" FontSize="15" />
                                <Slider Grid.Column="1" Style="{StaticResource CC.Level}" Margin="8,0"
                                        Value="{Binding Brightness, Mode=TwoWay}" ToolTip="Brightness"
                                        PreviewMouseLeftButtonDown="OnLevelMouseDown" PreviewMouseMove="OnLevelMouseMove"
                                        PreviewMouseLeftButtonUp="OnLevelMouseUp" MouseWheel="OnLevelWheel" />
                            </Grid>

                            <Button Style="{StaticResource CC.Row}" Margin="0,6,0,0" Padding="4,6"
                                    HorizontalContentAlignment="Stretch"
                                    Visibility="{Binding NightLightSupported, Converter={StaticResource BoolToVisibility}}"
                                    Command="{Binding ToggleNightLightSectionCommand}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="32" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="28" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Style="{StaticResource CC.Glyph}" Text="&#xE708;" FontSize="15" />
                                    <TextBlock Grid.Column="1" Text="Night light" FontSize="13" VerticalAlignment="Center" Margin="8,0,0,0" />
                                    <TextBlock Grid.Column="2" Text="{Binding NightLightStatus}" FontSize="12"
                                               Foreground="{DynamicResource Sol.ForegroundDimBrush}" VerticalAlignment="Center" Margin="0,0,4,0" />
                                    <TextBlock Grid.Column="3" Style="{StaticResource CC.Glyph}" Text="{Binding NightLightChevron}" FontSize="12" />
                                </Grid>
                            </Button>

                            <StackPanel Margin="4,4,4,2"
                                        Visibility="{Binding IsNightLightOpen, Converter={StaticResource BoolToVisibility}}">
                                <Grid Margin="0,4,0,8">
                                    <TextBlock Text="Blue light filter" FontSize="13" VerticalAlignment="Center" />
                                    <CheckBox Style="{StaticResource Sol.ToggleSwitch}" HorizontalAlignment="Right"
                                              IsChecked="{Binding IsNightLightOn, Mode=TwoWay}" />
                                </Grid>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="72" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Strength" FontSize="12" VerticalAlignment="Center"
                                               Foreground="{DynamicResource Sol.ForegroundDimBrush}" />
                                    <Slider Grid.Column="1" Style="{StaticResource CC.Level}" Minimum="0" Maximum="100"
                                            Value="{Binding NightLightStrength, Mode=TwoWay}" ToolTip="Night light strength"
                                            PreviewMouseLeftButtonDown="OnLevelMouseDown" PreviewMouseMove="OnLevelMouseMove"
                                            PreviewMouseLeftButtonUp="OnLevelMouseUp" MouseWheel="OnLevelWheel" />
                                </Grid>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <TextBlock Style="{StaticResource Sol.Label}" Text="Quick actions" Margin="4,14,4,8" />
                    <WrapPanel>
                        <Button Style="{StaticResource CC.Pill}" Content="File Explorer" Margin="0,0,8,8" Command="{Binding OpenFileExplorerCommand}" />
                        <Button Style="{StaticResource CC.Pill}" Content="Task Manager" Margin="0,0,8,8" Command="{Binding OpenTaskManagerCommand}" />
                        <Button Style="{StaticResource CC.Pill}" Content="Display" Margin="0,0,8,8" Command="{Binding OpenDisplaySettingsCommand}" />
                        <Button Style="{StaticResource CC.Pill}" Content="Night Light" Margin="0,0,8,8" Command="{Binding OpenNightLightCommand}" />
                        <Button Style="{StaticResource CC.Pill}" Content="Snipping Tool" Margin="0,0,8,8" Command="{Binding OpenSnippingToolCommand}" />
                        <Button Style="{StaticResource CC.Pill}" Content="Notifications" Margin="0,0,8,8" Command="{Binding OpenNotificationsCommand}" />
                        <Button Style="{StaticResource CC.Pill}" Content="Do Not Disturb" Margin="0,0,8,8" Command="{Binding OpenQuietHoursCommand}" />
                        <Button Style="{StaticResource CC.Pill}" Content="Lock" Margin="0,0,8,8" Command="{Binding LockCommand}" />
                        <Button Style="{StaticResource CC.Pill}" Content="Sleep" Margin="0,0,8,8" Command="{Binding SleepCommand}" />
                        <Button Style="{StaticResource CC.Pill}" Content="Restart" Margin="0,0,8,8" Command="{Binding RestartCommand}" />
                        <Button Style="{StaticResource CC.Pill}" Content="Shut down" Margin="0,0,8,8" Command="{Binding ShutDownCommand}" />
                    </WrapPanel>
                </StackPanel>

                <!-- ================= Wi-Fi page ================= -->
                <StackPanel Visibility="{Binding IsWifiPage, Converter={StaticResource BoolToVisibility}}">
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Button Style="{StaticResource CC.IconPill}" Content="&#xE72B;" Command="{Binding BackCommand}" ToolTip="Back" />
                        <TextBlock Grid.Column="1" Text="Wi-Fi" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center" Margin="10,0" />
                        <CheckBox Grid.Column="2" Style="{StaticResource Sol.ToggleSwitch}"
                                  IsChecked="{Binding IsWifiOn, Mode=OneWay}" IsEnabled="{Binding IsWifiAvailable}"
                                  Command="{Binding ToggleWifiCommand}" />
                    </Grid>

                    <TextBlock Style="{StaticResource Sol.Hint}" Text="{Binding WifiMessage}" Margin="4,0,4,8"
                               Foreground="{DynamicResource Sol.DangerBrush}"
                               Visibility="{Binding WifiMessage, Converter={StaticResource NullToVisibility}}" />

                    <Border Style="{StaticResource CC.Tile}" Margin="0,0,0,10"
                            Visibility="{Binding HasWifiAccessProblem, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource Sol.Hint}" Text="{Binding WifiAccessProblem}" Margin="0" />
                            <Button Style="{StaticResource CC.Pill}" Content="Location settings…" HorizontalAlignment="Left" Margin="0,8,0,0"
                                    Command="{Binding OpenLocationSettingsCommand}" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource CC.Tile}" Padding="4">
                        <Grid>
                            <TextBlock Style="{StaticResource Sol.Hint}" Margin="10,8" Text="Wi-Fi is off."
                                       Visibility="{Binding IsWifiOn, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}" />
                            <ScrollViewer MaxHeight="330" VerticalScrollBarVisibility="Auto"
                                          Visibility="{Binding IsWifiOn, Converter={StaticResource BoolToVisibility}}">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource Sol.Hint}" Margin="10,6" Text="Scanning…"
                                               Visibility="{Binding IsScanning, Converter={StaticResource BoolToVisibility}}" />
                                    <ItemsControl ItemsSource="{Binding WifiNetworks}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="{x:Type vm:WifiNetworkItem}">
                                                <StackPanel>
                                                    <Button Style="{StaticResource CC.Row}"
                                                            Command="{Binding DataContext.SelectNetworkCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                            CommandParameter="{Binding}">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto" />
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>
                                                            <ContentControl Content="{Binding SignalBars}" ContentTemplate="{StaticResource WifiBarsGlyph}"
                                                                            VerticalAlignment="Center" />
                                                            <StackPanel Grid.Column="1" Margin="12,0">
                                                                <TextBlock Text="{Binding Ssid}" FontSize="13" TextTrimming="CharacterEllipsis" />
                                                                <TextBlock Style="{StaticResource CC.Detail}" Text="{Binding Detail}" />
                                                            </StackPanel>
                                                            <StackPanel Grid.Column="2" Orientation="Horizontal">
                                                                <TextBlock Style="{StaticResource CC.Glyph}" Text="&#xE73E;" FontSize="13"
                                                                           Foreground="{DynamicResource Sol.AccentBrush}" Margin="0,0,8,0"
                                                                           Visibility="{Binding IsConnected, Converter={StaticResource BoolToVisibility}}" />
                                                                <TextBlock Style="{StaticResource CC.Glyph}" Text="&#xE72E;" FontSize="12"
                                                                           Foreground="{DynamicResource Sol.ForegroundDimBrush}"
                                                                           Visibility="{Binding IsSecured, Converter={StaticResource BoolToVisibility}}" />
                                                            </StackPanel>
                                                        </Grid>
                                                    </Button>

                                                    <Grid Margin="40,2,10,8" Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVisibility}}">
                                                        <Button Style="{StaticResource CC.Pill}" Content="Disconnect" HorizontalAlignment="Left"
                                                                Command="{Binding DataContext.DisconnectCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                CommandParameter="{Binding}"
                                                                Visibility="{Binding IsConnected, Converter={StaticResource BoolToVisibility}}" />
                                                        <Grid Visibility="{Binding IsConnected, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>
                                                            <PasswordBox x:Name="Password" Style="{StaticResource CC.Password}"
                                                                         KeyDown="OnPasswordKeyDown"
                                                                         IsVisibleChanged="OnPasswordVisibleChanged" />
                                                            <Button Grid.Column="1" Style="{StaticResource CC.Pill}" Content="Join" Margin="8,0,0,0"
                                                                    Tag="{Binding ElementName=Password}" Click="OnJoinClick" />
                                                        </Grid>
                                                    </Grid>
                                                </StackPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </ScrollViewer>
                        </Grid>
                    </Border>

                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                        <Button Style="{StaticResource CC.Pill}" Content="Scan again" Command="{Binding RescanWifiCommand}" Margin="0,0,8,0" />
                        <Button Style="{StaticResource CC.Pill}" Content="Wi-Fi settings…" Command="{Binding OpenWifiSettingsCommand}" />
                    </StackPanel>
                </StackPanel>

                <!-- ================= Bluetooth page ================= -->
                <StackPanel Visibility="{Binding IsBluetoothPage, Converter={StaticResource BoolToVisibility}}">
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Button Style="{StaticResource CC.IconPill}" Content="&#xE72B;" Command="{Binding BackCommand}" ToolTip="Back" />
                        <TextBlock Grid.Column="1" Text="Bluetooth" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center" Margin="10,0" />
                        <CheckBox Grid.Column="2" Style="{StaticResource Sol.ToggleSwitch}"
                                  IsChecked="{Binding IsBluetoothOn, Mode=OneWay}" IsEnabled="{Binding IsBluetoothAvailable}"
                                  Command="{Binding ToggleBluetoothCommand}" />
                    </Grid>

                    <TextBlock Style="{StaticResource Sol.Hint}" Text="{Binding BluetoothMessage}" Margin="4,0,4,8"
                               Foreground="{DynamicResource Sol.DangerBrush}"
                               Visibility="{Binding BluetoothMessage, Converter={StaticResource NullToVisibility}}" />

                    <Border Style="{StaticResource CC.Tile}" Padding="4">
                        <StackPanel>
                            <TextBlock Style="{StaticResource Sol.Hint}" Margin="10,8" Text="No paired devices."
                                       Visibility="{Binding HasBluetoothDevices, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}" />
                            <ScrollViewer MaxHeight="330" VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding BluetoothDevices}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Style="{StaticResource CC.Row}"
                                                    Command="{Binding DataContext.OpenBluetoothSettingsCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Style="{StaticResource CC.Glyph}" Text="&#xE702;" Width="18" />
                                                    <StackPanel Grid.Column="1" Margin="12,0">
                                                        <TextBlock Text="{Binding Name}" FontSize="13" TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Style="{StaticResource CC.Detail}" Text="{Binding Detail}" />
                                                    </StackPanel>
                                                    <Ellipse Grid.Column="2" Width="7" Height="7" Fill="{DynamicResource Sol.AccentBrush}"
                                                             Visibility="{Binding IsConnected, Converter={StaticResource BoolToVisibility}}" />
                                                </Grid>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </StackPanel>
                    </Border>

                    <TextBlock Style="{StaticResource Sol.Hint}" Margin="4,8,4,0"
                               Text="Windows only lets its own Settings pair and connect Bluetooth devices." />
                    <Button Style="{StaticResource CC.Pill}" Content="Bluetooth settings…" HorizontalAlignment="Left" Margin="0,10,0,0"
                            Command="{Binding OpenBluetoothSettingsCommand}" />
                </StackPanel>

                <!-- ================= Sound page ================= -->
                <StackPanel Visibility="{Binding IsSoundPage, Converter={StaticResource BoolToVisibility}}">
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button Style="{StaticResource CC.IconPill}" Content="&#xE72B;" Command="{Binding BackCommand}" ToolTip="Back" />
                        <TextBlock Grid.Column="1" Text="Sound output" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center" Margin="10,0" />
                    </Grid>

                    <Border Style="{StaticResource CC.Tile}" Padding="8" Margin="0,0,0,10"
                            Visibility="{Binding HasAudioDevice, Converter={StaticResource BoolToVisibility}}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Button Style="{StaticResource CC.IconPill}" Content="{Binding VolumeGlyph}" Background="Transparent"
                                    Command="{Binding ToggleMuteCommand}" ToolTip="Mute" />
                            <Slider Grid.Column="1" Style="{StaticResource CC.Level}" Margin="8,0,2,0"
                                    Value="{Binding Volume, Mode=TwoWay}"
                                    PreviewMouseLeftButtonDown="OnLevelMouseDown" PreviewMouseMove="OnLevelMouseMove"
                                    PreviewMouseLeftButtonUp="OnLevelMouseUp" MouseWheel="OnLevelWheel" />
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource CC.Tile}" Padding="4">
                        <ScrollViewer MaxHeight="330" VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding OutputDevices}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Style="{StaticResource CC.Row}"
                                                Command="{Binding DataContext.SelectOutputCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Style="{StaticResource CC.Glyph}" Text="&#xE7F5;" Width="18" />
                                                <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="13" Margin="12,0"
                                                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="2" Style="{StaticResource CC.Glyph}" Text="&#xE73E;" FontSize="13"
                                                           Foreground="{DynamicResource Sol.AccentBrush}"
                                                           Visibility="{Binding IsDefault, Converter={StaticResource BoolToVisibility}}" />
                                            </Grid>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Border>

                    <Button Style="{StaticResource CC.Pill}" Content="Sound settings…" HorizontalAlignment="Left" Margin="0,10,0,0"
                            Command="{Binding OpenSoundSettingsCommand}" />
                </StackPanel>

                <!-- ================= Ethernet page ================= -->
                <StackPanel Visibility="{Binding IsEthernetPage, Converter={StaticResource BoolToVisibility}}">
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button Style="{StaticResource CC.IconPill}" Content="&#xE72B;" Command="{Binding BackCommand}" ToolTip="Back" />
                        <TextBlock Grid.Column="1" Text="Ethernet" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center" Margin="10,0" />
                    </Grid>

                    <Border Style="{StaticResource CC.Tile}"
                            Visibility="{Binding HasEthernet, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}">
                        <TextBlock Style="{StaticResource Sol.Hint}" Margin="0" Text="No wired network adapter found." />
                    </Border>

                    <ItemsControl ItemsSource="{Binding EthernetAdapters}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource CC.Tile}" Margin="0,0,0,10" Padding="14,12">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Name}" FontSize="13.5" FontWeight="SemiBold" Margin="0,0,0,8" />
                                        <ItemsControl ItemsSource="{Binding Details}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Margin="0,3">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="100" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Text="{Binding Label}" FontSize="12" Foreground="{DynamicResource Sol.ForegroundDimBrush}" />
                                                        <TextBox Grid.Column="1" Text="{Binding Value, Mode=OneWay}" FontSize="12" IsReadOnly="True"
                                                                 Background="Transparent" BorderThickness="0" Padding="0" TextWrapping="Wrap"
                                                                 Foreground="{DynamicResource Sol.ForegroundBrush}"
                                                                 SelectionBrush="{DynamicResource Sol.AccentBrush}" />
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Button Style="{StaticResource CC.Pill}" Content="Ethernet settings…" HorizontalAlignment="Left"
                            Command="{Binding OpenEthernetSettingsCommand}" />
                </StackPanel>
            </StackPanel>
            </Canvas>
        </controls:FlaredPanel>
    </Grid>
</Window>

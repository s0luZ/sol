<Window x:Class="SolDesktop.Views.DockWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:SolDesktop.Converters"
        xmlns:controls="clr-namespace:SolDesktop.Controls"
        xmlns:vm="clr-namespace:SolDesktop.ViewModels"
        Title="Sol Dock"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True" ShowActivated="False"
        AllowDrop="True" UseLayoutRounding="True"
        FontFamily="{DynamicResource Sol.TextFont}"
        Foreground="{DynamicResource Sol.ForegroundBrush}">

    <Window.Resources>
        <conv:BoolToVisibilityConverter x:Key="Visible" />

        <DataTemplate x:Key="DockItemTemplate" DataType="{x:Type vm:DockItemViewModel}">
            <Grid Background="Transparent"
                  Height="{Binding DockItemHeight, Source={x:Static vm:Appearance.Current}}"
                  ToolTip="{Binding ToolTipText}"
                  ToolTipService.Placement="Top"
                  ToolTipService.InitialShowDelay="250"
                  ToolTipService.VerticalOffset="-6">

                <Border Width="1" Margin="0,8,0,14" HorizontalAlignment="Center"
                        Background="{DynamicResource Sol.ForegroundFaintBrush}"
                        Visibility="{Binding IsSeparator, Converter={StaticResource Visible}}" />

                <!-- Magnification scales this from its bottom edge, so icons grow up out of the bar. -->
                <Grid x:Name="IconHost"
                      Width="{Binding DockIconSize, Source={x:Static vm:Appearance.Current}}"
                      Height="{Binding DockIconSize, Source={x:Static vm:Appearance.Current}}"
                      HorizontalAlignment="Center" VerticalAlignment="Top"
                      RenderTransformOrigin="0.5,1"
                      Visibility="{Binding IsSeparator, Converter={StaticResource Visible}, ConverterParameter=Invert}">

                    <Image Source="{Binding Icon}" RenderOptions.BitmapScalingMode="HighQuality"
                           Visibility="{Binding ShowsImage, Converter={StaticResource Visible}}" />

                    <Border Background="{DynamicResource Sol.SurfaceHoverBrush}"
                            CornerRadius="{Binding DockTileCornerRadius, Source={x:Static vm:Appearance.Current}}"
                            Visibility="{Binding IsFolder, Converter={StaticResource Visible}}">
                        <Grid>
                            <TextBlock FontFamily="{StaticResource Sol.IconFont}" Text="&#xE8B7;"
                                       FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Foreground="{DynamicResource Sol.ForegroundDimBrush}"
                                       Visibility="{Binding FolderHasIcons, Converter={StaticResource Visible}, ConverterParameter=Invert}" />
                            <UniformGrid Rows="2" Columns="2" Margin="5"
                                         Visibility="{Binding FolderHasIcons, Converter={StaticResource Visible}}">
                                <Image Source="{Binding FolderIcon0}" Margin="1" RenderOptions.BitmapScalingMode="HighQuality" />
                                <Image Source="{Binding FolderIcon1}" Margin="1" RenderOptions.BitmapScalingMode="HighQuality" />
                                <Image Source="{Binding FolderIcon2}" Margin="1" RenderOptions.BitmapScalingMode="HighQuality" />
                                <Image Source="{Binding FolderIcon3}" Margin="1" RenderOptions.BitmapScalingMode="HighQuality" />
                            </UniformGrid>
                        </Grid>
                    </Border>

                    <Border Background="{DynamicResource Sol.SurfaceHoverBrush}"
                            CornerRadius="{Binding DockTileCornerRadius, Source={x:Static vm:Appearance.Current}}"
                            Visibility="{Binding IsStart, Converter={StaticResource Visible}}">
                        <Viewbox Margin="12">
                            <Canvas Width="20" Height="20">
                                <Rectangle Width="9.2" Height="9.2" RadiusX="1.6" RadiusY="1.6" Fill="{DynamicResource Sol.ForegroundBrush}" />
                                <Rectangle Canvas.Left="10.8" Width="9.2" Height="9.2" RadiusX="1.6" RadiusY="1.6" Fill="{DynamicResource Sol.ForegroundBrush}" />
                                <Rectangle Canvas.Top="10.8" Width="9.2" Height="9.2" RadiusX="1.6" RadiusY="1.6" Fill="{DynamicResource Sol.ForegroundBrush}" />
                                <Rectangle Canvas.Left="10.8" Canvas.Top="10.8" Width="9.2" Height="9.2" RadiusX="1.6" RadiusY="1.6" Fill="{DynamicResource Sol.AccentBrush}" />
                            </Canvas>
                        </Viewbox>
                    </Border>
                </Grid>

                <!-- Running indicator; the active app gets a wider accent pill. -->
                <Border VerticalAlignment="Bottom" HorizontalAlignment="Center" Height="4" Margin="0,0,0,2" CornerRadius="2"
                        Visibility="{Binding IsRunning, Converter={StaticResource Visible}}">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Width" Value="4" />
                            <Setter Property="Background" Value="{DynamicResource Sol.ForegroundDimBrush}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsActive}" Value="True">
                                    <Setter Property="Width" Value="12" />
                                    <Setter Property="Background" Value="{DynamicResource Sol.AccentBrush}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                </Border>
            </Grid>
        </DataTemplate>

        <Style x:Key="DockItemContainer" TargetType="ContentPresenter">
            <EventSetter Event="MouseEnter" Handler="OnItemMouseEnter" />
            <EventSetter Event="MouseLeave" Handler="OnItemMouseLeave" />
            <EventSetter Event="PreviewMouseLeftButtonDown" Handler="OnItemMouseDown" />
            <EventSetter Event="MouseUp" Handler="OnItemMouseUp" />
            <EventSetter Event="MouseRightButtonUp" Handler="OnItemRightClick" />
        </Style>
    </Window.Resources>

    <Grid>
        <controls:FlaredPanel x:Name="Bar" Edge="Bottom"
                              HorizontalAlignment="Center" VerticalAlignment="Bottom"
                              Padding="10,7,10,1"
                              Background="{DynamicResource Sol.SurfaceBrush}"
                              BorderBrush="{DynamicResource Sol.SurfaceBorderBrush}"
                              CornerRadius="{Binding CornerRadius, Source={x:Static vm:Appearance.Current}}"
                              FlareRadius="{Binding FlareRadius, Source={x:Static vm:Appearance.Current}}"
                              MouseRightButtonUp="OnBarRightClick">
            <controls:FlaredPanel.RenderTransform>
                <TranslateTransform x:Name="Slide" />
            </controls:FlaredPanel.RenderTransform>
            <controls:FlaredPanel.Effect>
                <DropShadowEffect BlurRadius="18" ShadowDepth="3" Direction="90" Opacity="0.45" Color="Black" />
            </controls:FlaredPanel.Effect>

            <StackPanel Orientation="Horizontal">
            <ItemsControl x:Name="Items"
                          ItemsSource="{Binding Items}"
                          ItemTemplate="{StaticResource DockItemTemplate}"
                          ItemContainerStyle="{StaticResource DockItemContainer}"
                          Background="Transparent"
                          MouseLeave="OnItemsMouseLeave">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
            </ItemsControl>
            <Button Width="8" Height="18" Margin="6,0,2,12" VerticalAlignment="Center" Focusable="False"
                    Cursor="Hand" ToolTip="Show desktop" Click="OnShowDesktop">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Line" Width="3" Height="14" CornerRadius="1.5" HorizontalAlignment="Center"
                                Background="{DynamicResource Sol.ForegroundDimBrush}" />
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Line" Property="Background" Value="{DynamicResource Sol.ForegroundBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>
            </StackPanel>
        </controls:FlaredPanel>
    </Grid>
</Window>

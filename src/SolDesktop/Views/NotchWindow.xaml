<Window x:Class="SolDesktop.Views.NotchWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:SolDesktop.Converters"
        Title="Sol Desktop"
        Width="460" Height="72"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True" ShowActivated="False"
        UseLayoutRounding="True"
        FontFamily="{StaticResource Sol.TextFont}"
        Foreground="{StaticResource Sol.ForegroundBrush}">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <conv:SignalBarOpacityConverter x:Key="SignalBarOpacity" />

        <Style x:Key="WifiArc" TargetType="Path">
            <Setter Property="Stroke" Value="{StaticResource Sol.ForegroundBrush}" />
            <Setter Property="StrokeThickness" Value="2.4" />
            <Setter Property="StrokeStartLineCap" Value="Round" />
            <Setter Property="StrokeEndLineCap" Value="Round" />
        </Style>

        <CubicEase x:Key="EaseOut" EasingMode="EaseOut" />

        <Storyboard x:Key="HoverIn">
            <DoubleAnimation Storyboard.TargetName="NotchScale" Storyboard.TargetProperty="ScaleX" To="1.04" Duration="0:0:0.18" EasingFunction="{StaticResource EaseOut}" />
            <DoubleAnimation Storyboard.TargetName="NotchScale" Storyboard.TargetProperty="ScaleY" To="1.04" Duration="0:0:0.18" EasingFunction="{StaticResource EaseOut}" />
            <DoubleAnimation Storyboard.TargetName="Grabber" Storyboard.TargetProperty="Opacity" To="0.7" Duration="0:0:0.18" />
        </Storyboard>
        <Storyboard x:Key="HoverOut">
            <DoubleAnimation Storyboard.TargetName="NotchScale" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.22" EasingFunction="{StaticResource EaseOut}" />
            <DoubleAnimation Storyboard.TargetName="NotchScale" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.22" EasingFunction="{StaticResource EaseOut}" />
            <DoubleAnimation Storyboard.TargetName="Grabber" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.22" />
        </Storyboard>
    </Window.Resources>

    <Border x:Name="NotchBody"
            HorizontalAlignment="Center" VerticalAlignment="Top"
            MinWidth="300" Height="38"
            Padding="16,0,12,3"
            CornerRadius="0,0,19,19"
            Background="{StaticResource Sol.SurfaceBrush}"
            BorderBrush="{StaticResource Sol.SurfaceBorderBrush}"
            BorderThickness="1,0,1,1"
            RenderTransformOrigin="0.5,0">
        <Border.RenderTransform>
            <ScaleTransform x:Name="NotchScale" />
        </Border.RenderTransform>
        <Border.Effect>
            <DropShadowEffect BlurRadius="18" ShadowDepth="3" Direction="270" Opacity="0.45" Color="Black" />
        </Border.Effect>
        <Border.Triggers>
            <EventTrigger RoutedEvent="MouseEnter">
                <BeginStoryboard Storyboard="{StaticResource HoverIn}" />
            </EventTrigger>
            <EventTrigger RoutedEvent="MouseLeave">
                <BeginStoryboard Storyboard="{StaticResource HoverOut}" />
            </EventTrigger>
        </Border.Triggers>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" MinWidth="28" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Left: Sol mark, time, date -->
            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                <Ellipse Width="8" Height="8" Fill="{StaticResource Sol.AccentBrush}" VerticalAlignment="Center" Margin="0,0,9,0" />
                <TextBlock Text="{Binding TimeText}" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
                <TextBlock Text="{Binding DateText}" FontSize="12" Foreground="{StaticResource Sol.ForegroundDimBrush}" VerticalAlignment="Center" Margin="8,0,0,0" />
            </StackPanel>

            <!-- Right: status icons -->
            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">

                <Viewbox Width="17" Height="17" Margin="6,0"
                         Visibility="{Binding IsWifiIconVisible, Converter={StaticResource BoolToVisibility}}"
                         Opacity="{Binding NetworkOpacity}"
                         ToolTip="{Binding NetworkTooltip}">
                    <Canvas Width="24" Height="24" Background="Transparent">
                        <Path Style="{StaticResource WifiArc}" Data="M 9.17,15.17 A 4,4 0 0 1 14.83,15.17"
                              Opacity="{Binding WifiBars, Converter={StaticResource SignalBarOpacity}, ConverterParameter=1}" />
                        <Path Style="{StaticResource WifiArc}" Data="M 6.34,12.34 A 8,8 0 0 1 17.66,12.34"
                              Opacity="{Binding WifiBars, Converter={StaticResource SignalBarOpacity}, ConverterParameter=3}" />
                        <Path Style="{StaticResource WifiArc}" Data="M 3.51,9.51 A 12,12 0 0 1 20.49,9.51"
                              Opacity="{Binding WifiBars, Converter={StaticResource SignalBarOpacity}, ConverterParameter=4}" />
                        <Ellipse Canvas.Left="10.4" Canvas.Top="16.4" Width="3.2" Height="3.2" Fill="{StaticResource Sol.ForegroundBrush}" />
                    </Canvas>
                </Viewbox>

                <TextBlock Style="{StaticResource Sol.IconText}" Text="&#xE839;"
                           Visibility="{Binding IsEthernet, Converter={StaticResource BoolToVisibility}}"
                           Opacity="{Binding NetworkOpacity}"
                           ToolTip="{Binding NetworkTooltip}" />

                <TextBlock Style="{StaticResource Sol.IconText}" Text="&#xE702;"
                           Visibility="{Binding IsBluetoothAvailable, Converter={StaticResource BoolToVisibility}}"
                           Opacity="{Binding BluetoothOpacity}"
                           ToolTip="{Binding BluetoothTooltip}" />

                <TextBlock Style="{StaticResource Sol.IconText}" Text="{Binding VolumeGlyph}"
                           ToolTip="{Binding VolumeTooltip}" />

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="6,0,2,0"
                            Background="Transparent"
                            ToolTip="{Binding BatteryTooltip}"
                            Visibility="{Binding HasBattery, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="{Binding BatteryPercent, StringFormat={}{0}%}" FontSize="11.5"
                               Foreground="{StaticResource Sol.ForegroundDimBrush}" VerticalAlignment="Center" Margin="0,0,5,0" />
                    <Grid Width="23" Height="11" VerticalAlignment="Center">
                        <Border Width="21" HorizontalAlignment="Left" CornerRadius="3"
                                BorderBrush="{StaticResource Sol.ForegroundDimBrush}" BorderThickness="1.2" />
                        <Border HorizontalAlignment="Left" Margin="3,2.6,0,2.6" CornerRadius="1.5" Width="{Binding BatteryFillWidth}">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="{StaticResource Sol.ForegroundBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsCharging}" Value="True">
                                            <Setter Property="Background" Value="{StaticResource Sol.SuccessBrush}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsBatteryLow}" Value="True">
                                            <Setter Property="Background" Value="{StaticResource Sol.DangerBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                        </Border>
                        <Border Width="2" Height="5" HorizontalAlignment="Right" CornerRadius="0,1,1,0"
                                Background="{StaticResource Sol.ForegroundDimBrush}" />
                    </Grid>
                </StackPanel>
            </StackPanel>

            <!-- Pull-down hint, shown on hover -->
            <Border x:Name="Grabber" Grid.ColumnSpan="3"
                    Width="34" Height="3" CornerRadius="1.5"
                    HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,-1"
                    Background="{StaticResource Sol.ForegroundDimBrush}" Opacity="0" />
        </Grid>
    </Border>
</Window>

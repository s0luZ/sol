<Window x:Class="SolDesktop.Views.NotchWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:SolDesktop.Converters"
        xmlns:controls="clr-namespace:SolDesktop.Controls"
        xmlns:vm="clr-namespace:SolDesktop.ViewModels"
        Title="Sol Desktop Notch"
        SizeToContent="WidthAndHeight"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True" ShowActivated="False"
        UseLayoutRounding="True"
        FontFamily="{DynamicResource Sol.TextFont}"
        Foreground="{DynamicResource Sol.ForegroundBrush}">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <conv:SignalBarOpacityConverter x:Key="SignalBarOpacity" />

        <Style x:Key="Notch.Hit" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Padding" Value="4,3" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="7"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Sol.SurfaceHoverBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="WifiArc" TargetType="Path">
            <Setter Property="Stroke" Value="{DynamicResource Sol.ForegroundBrush}" />
            <Setter Property="StrokeThickness" Value="2.4" />
            <Setter Property="StrokeStartLineCap" Value="Round" />
            <Setter Property="StrokeEndLineCap" Value="Round" />
        </Style>
    </Window.Resources>

    <!-- Side and bottom margins leave room for the shadow; the top stays flush with the screen edge. -->
    <Grid Margin="28,0,28,28" ClipToBounds="True">
        <controls:FlaredPanel x:Name="Bar" Edge="Top"
                              HorizontalAlignment="Center" VerticalAlignment="Top"
                              Padding="14,0,12,1"
                              Background="{DynamicResource Sol.SurfaceBrush}"
                              BorderBrush="{DynamicResource Sol.SurfaceBorderBrush}"
                              CornerRadius="{Binding CornerRadius, Source={x:Static vm:Appearance.Current}}"
                              FlareRadius="{Binding FlareRadius, Source={x:Static vm:Appearance.Current}}"
                              Cursor="SizeNS"
                              MouseLeftButtonDown="OnBarMouseDown"
                              MouseMove="OnBarMouseMove"
                              MouseLeftButtonUp="OnBarMouseUp"
                              LostMouseCapture="OnBarLostCapture"
                              MouseRightButtonUp="OnBarRightClick">
            <controls:FlaredPanel.RenderTransform>
                <TranslateTransform x:Name="Slide" />
            </controls:FlaredPanel.RenderTransform>
            <controls:FlaredPanel.Effect>
                <DropShadowEffect BlurRadius="18" ShadowDepth="3" Direction="270" Opacity="0.45" Color="Black" />
            </controls:FlaredPanel.Effect>

            <Grid Height="36" MinWidth="270">
                <Grid.LayoutTransform>
                    <ScaleTransform ScaleX="{Binding NotchScale, Source={x:Static vm:Appearance.Current}}"
                                    ScaleY="{Binding NotchScale, Source={x:Static vm:Appearance.Current}}" />
                </Grid.LayoutTransform>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" MinWidth="28" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Hover grabber: a handle you can drag down into Control Centre. -->
                <Border x:Name="Grabber" Grid.ColumnSpan="3"
                        Width="10" Height="3" CornerRadius="1.5"
                        HorizontalAlignment="Center" VerticalAlignment="Bottom"
                        Margin="0,0,0,3" Opacity="0" IsHitTestVisible="False"
                        Background="{DynamicResource Sol.ForegroundDimBrush}" />

                <!-- Left: Sol mark, time, date -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse Width="8" Height="8" Fill="{DynamicResource Sol.AccentBrush}" VerticalAlignment="Center" Margin="0,0,9,0" />
                    <TextBlock Text="{Binding TimeText}" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding DateText}" FontSize="12" Foreground="{DynamicResource Sol.ForegroundDimBrush}"
                               VerticalAlignment="Center" Margin="8,0,0,0" />
                </StackPanel>

                <!-- Right: status icons — each opens only that control, plus a tray chevron. -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">

                    <Button Style="{StaticResource Notch.Hit}" Click="OnWifiClick"
                            Visibility="{Binding IsWifiIconVisible, Converter={StaticResource BoolToVisibility}}"
                            Opacity="{Binding NetworkOpacity}" ToolTip="{Binding NetworkTooltip}">
                        <Viewbox Width="17" Height="17">
                            <Canvas Width="24" Height="24" Background="Transparent">
                                <Path Style="{StaticResource WifiArc}" Data="M 9.17,15.17 A 4,4 0 0 1 14.83,15.17"
                                      Opacity="{Binding WifiBars, Converter={StaticResource SignalBarOpacity}, ConverterParameter=1}" />
                                <Path Style="{StaticResource WifiArc}" Data="M 6.34,12.34 A 8,8 0 0 1 17.66,12.34"
                                      Opacity="{Binding WifiBars, Converter={StaticResource SignalBarOpacity}, ConverterParameter=3}" />
                                <Path Style="{StaticResource WifiArc}" Data="M 3.51,9.51 A 12,12 0 0 1 20.49,9.51"
                                      Opacity="{Binding WifiBars, Converter={StaticResource SignalBarOpacity}, ConverterParameter=4}" />
                                <Ellipse Canvas.Left="10.4" Canvas.Top="16.4" Width="3.2" Height="3.2" Fill="{DynamicResource Sol.ForegroundBrush}" />
                            </Canvas>
                        </Viewbox>
                    </Button>

                    <Button Style="{StaticResource Notch.Hit}" Click="OnEthernetClick"
                            Visibility="{Binding IsEthernet, Converter={StaticResource BoolToVisibility}}"
                            Opacity="{Binding NetworkOpacity}" ToolTip="{Binding NetworkTooltip}">
                        <TextBlock Style="{StaticResource Sol.IconText}" Text="&#xE839;" Margin="0" />
                    </Button>

                    <Button Style="{StaticResource Notch.Hit}" Click="OnBluetoothClick"
                            Visibility="{Binding IsBluetoothAvailable, Converter={StaticResource BoolToVisibility}}"
                            Opacity="{Binding BluetoothOpacity}" ToolTip="{Binding BluetoothTooltip}">
                        <TextBlock Style="{StaticResource Sol.IconText}" Text="&#xE702;" Margin="0" />
                    </Button>

                    <Button Style="{StaticResource Notch.Hit}" Click="OnSoundClick" ToolTip="{Binding VolumeTooltip}">
                        <TextBlock Style="{StaticResource Sol.IconText}" Text="{Binding VolumeGlyph}" Margin="0" />
                    </Button>

                    <Button Style="{StaticResource Notch.Hit}" Click="OnTrayClick" ToolTip="Tray icons">
                        <TextBlock FontFamily="{StaticResource Sol.IconFont}" Text="&#xE70D;" FontSize="11"
                                   Foreground="{DynamicResource Sol.ForegroundDimBrush}" />
                    </Button>

                    <Button Style="{StaticResource Notch.Hit}" Click="OnBatteryClick" Padding="6,3"
                            ToolTip="{Binding BatteryTooltip}"
                            Visibility="{Binding HasBattery, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding BatteryPercent, StringFormat={}{0}%}" FontSize="11.5"
                                       Foreground="{DynamicResource Sol.ForegroundDimBrush}" VerticalAlignment="Center" Margin="0,0,5,0" />
                            <Grid Width="23" Height="11" VerticalAlignment="Center">
                                <Border Width="21" HorizontalAlignment="Left" CornerRadius="3"
                                        BorderBrush="{DynamicResource Sol.ForegroundDimBrush}" BorderThickness="1.2" />
                                <Border HorizontalAlignment="Left" Margin="3,2.6,0,2.6" CornerRadius="1.5" Width="{Binding BatteryFillWidth}">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="{DynamicResource Sol.ForegroundBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsCharging}" Value="True">
                                                    <Setter Property="Background" Value="{DynamicResource Sol.SuccessBrush}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsBatteryLow}" Value="True">
                                                    <Setter Property="Background" Value="{DynamicResource Sol.DangerBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                </Border>
                                <Border Width="2" Height="5" HorizontalAlignment="Right" CornerRadius="0,1,1,0"
                                        Background="{DynamicResource Sol.ForegroundDimBrush}" />
                            </Grid>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </controls:FlaredPanel>
    </Grid>
</Window>

<Window x:Class="SolDesktop.Views.NamePromptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Sol"
        SizeToContent="WidthAndHeight"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True"
        WindowStartupLocation="CenterScreen"
        FontFamily="{DynamicResource Sol.TextFont}"
        Foreground="{DynamicResource Sol.ForegroundBrush}">

    <Border Width="340" Padding="22,20,22,18" CornerRadius="18" BorderThickness="1"
            Background="{DynamicResource Sol.SurfaceSolidBrush}"
            BorderBrush="{DynamicResource Sol.SurfaceBorderBrush}">
        <Border.Effect>
            <DropShadowEffect BlurRadius="28" ShadowDepth="8" Direction="270" Opacity="0.45" Color="Black" />
        </Border.Effect>
        <StackPanel>
            <TextBlock x:Name="PromptTitle" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,12" />
            <TextBox x:Name="NameBox" Style="{StaticResource Sol.TextBox}" FontFamily="{DynamicResource Sol.TextFont}"
                     FontSize="14" KeyDown="OnNameKeyDown" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                <Button Style="{StaticResource Sol.Button}" Content="Cancel" Click="OnCancel" Margin="0,0,8,0" />
                <Button x:Name="ConfirmButton" Style="{StaticResource Sol.Button}" Content="Create" Click="OnConfirm" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
